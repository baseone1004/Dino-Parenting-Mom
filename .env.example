# ---- Claude API 모드에서만 필요 (ai.backend: api) ----
ANTHROPIC_API_KEY=

# ---- 쿠팡 파트너스 Open API (파트너스 > 링크 생성 > API 키 발급) ----
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ---- Threads 앱 시크릿 (장기 토큰 교환/갱신에 사용, Meta 개발자 앱 설정 > 기본) ----
THREADS_APP_SECRET=

# ---- 계정별 Threads 토큰 (대시보드에서 입력해도 됨. 대시보드 입력값이 우선) ----
# THREADS_TOKEN_DEMO=

# ---- 페이스북/인스타그램 (Meta 개발자 앱, scripts/setup_facebook.md 참고) ----
# 페이지 액세스 토큰은 대시보드에서 입력 (계정 DB에 저장). 앱 키는 장기 토큰 교환에만 필요.
META_APP_ID=
META_APP_SECRET=

# ---- 인스타그램 카드뉴스 이미지 생성용 Google Slides API (scripts/setup_google_slides.md 참고) ----
# 서비스 계정은 개인 Gmail 환경에서 Drive 저장용량이 0이라 못 씀 — 사용자 계정 OAuth 사용
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
SLIDES_TEMPLATE_ID=

# ---- 일상글(상품 링크 없는 글) 카드뉴스 표지 이미지 자동 생성 — https://kie.ai ----
KIE_API_KEY=

# ---- 토스쇼핑 쉐어링크 Open API (승인 후 발급, scripts/setup_toss.md 참고) ----
TOSS_ACCESS_KEY=
TOSS_SECRET_KEY=
TOSS_PUBLISHER_ID=

# ---- 텔레그램 알림 (게시 성공/실패 시 메시지 전송, scripts/setup_telegram.md 참고) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 외부 공개 대시보드 로그인 비밀번호 (반드시 길고 임의의 값으로 변경)
DASHBOARD_PASSWORD=
# ---- OpenAI 글 생성 (ai.backend: openai, API 사용료 별도) ----
OPENAI_API_KEY=
